# Names only. Never commit values.

# Build-time (set by the GitHub Pages workflow for previews; set SITE_URL to the real domain in Cloudflare Pages)
SITE_URL=
SITE_BASE=

# Cookie-free analytics (Plausible-compatible script). Leave empty to load no analytics at all.
PUBLIC_ANALYTICS_SRC=
PUBLIC_ANALYTICS_DOMAIN=

# Ed25519 public key (base64 or hex) the browser uses to verify license codes. Public, safe to embed.
PUBLIC_LICENSE_PUBLIC_KEY=

# Cloudflare Pages Function secrets (functions/api/*). Test-mode Stripe keys only until the owner goes live.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
LICENSE_SIGNING_KEY=
