---
import Base from '../layouts/Base.astro';
import Workbook from '../components/Workbook';
import { withBase } from '../lib/url';
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'PFIC Workbook',
  description: 'Per-lot section 1291 and mark-to-market figures for IRS Form 8621, filled into the official PDF in the browser.',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any (web browser)',
  url: new URL(withBase('/'), Astro.site).href,
  offers: { '@type': 'Offer', price: '55', priceCurrency: 'USD', description: 'One tax year, all funds. The first fund is free.' },
}];
---
<Base
  jsonLd={jsonLd}
  title="Form 8621 PFIC calculator, lot by lot | PFIC Workbook"
  description="Enter every SIP or ETF purchase once. Your browser works out the per-lot §1291 figures for Form 8621. Nothing leaves your device."
>
  <section class="intro">
    <div class="intro-text">
      <p class="eyebrow">Form 8621 · PFIC</p>
      <h1>Fill Form 8621 for every fund, lot by lot.</h1>
      <p class="lede">Paste your purchases and sales. The workbook spreads each gain over the days you held it and shows the Part V lines. It all runs in this browser.</p>
    </div>
    <figure class="intro-art">
      <img src={withBase('/art/hero.svg')} width="1200" height="720" alt="Monthly purchase slips on a ruled analysis pad, feeding one Form 8621" fetchpriority="high" />
      <figcaption class="caption">Exhibit A — monthly slips, one pad, one form per fund.</figcaption>
    </figure>
  </section>

  <Workbook client:load />

  <figure class="art-after">
    <img src={withBase('/art/hero.svg')} width="1200" height="720" alt="" loading="lazy" />
    <figcaption class="caption">Exhibit A — monthly slips, one pad, one form per fund.</figcaption>
  </figure>

  <section class="section" aria-labelledby="steps-h">
    <h2 id="steps-h">What happens to your rows</h2>
    <ol class="steps">
      <li>
        <img src={withBase('/art/spot-1.svg')} width="400" height="300" alt="" loading="lazy" />
        <h3>List every lot</h3>
        <p>Date, units and amount for each purchase, reinvested dividend and sale, with the rate to USD for that day.</p>
      </li>
      <li>
        <img src={withBase('/art/spot-2.svg')} width="400" height="300" alt="" loading="lazy" />
        <h3>Sales are matched first in, first out</h3>
        <p>Each sale takes the oldest units first. A part-sold lot is split in proportion to its units.</p>
      </li>
      <li>
        <img src={withBase('/art/spot-3.svg')} width="400" height="300" alt="" loading="lazy" />
        <h3>Read off the lines</h3>
        <p>Gain per day held, tax at each earlier year's top rate, and interest from that year's due date.</p>
      </li>
    </ol>
    <p class="price-line" style="margin-top: var(--row);">Your first fund is free, filled PDF included. All funds for tax year 2025: USD 55, once. <a href={withBase('/pricing')}>See pricing</a></p>
    <p class="disclaimer" style="margin-top: var(--row);">Prepared with PFIC Workbook from figures you entered. This is not tax advice. Check it or have a preparer check it.</p>
  </section>
</Base>
